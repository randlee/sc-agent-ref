<urn:atm:triage:finding/RBP-F010>
  a triage:Finding ;
  triage:findingId "RBP-F010" ;
  triage:title "Several new error paths define a code but no recovery hint. Only DecisionSchemaId names it" ;
  triage:description "Several new error paths define a code but no recovery hint. Only DecisionSchemaId names its remedy ('hint lists KNOWN'). Not specified: ModelAliases::with_override unknown alias (should list valid aliases), ProjectLabel::new (limits), and try_from_fields (should name the offending key). The [models] path remaps a ModelId::from_str INPUT_INVALID to CONFIG_INVALID by inspecting the code, so the original message and hint must survive the remap. Recommendation: State in the sample doc comments that each of these returns a JevError with a fix hint (valid aliases, the limits, the key name), and that the CONFIG_INVALID remap preserves the hint and adds the check.toml key." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
