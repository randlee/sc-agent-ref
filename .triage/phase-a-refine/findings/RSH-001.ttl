<urn:atm:triage:finding/RSH-001>
  a triage:Finding ;
  triage:findingId "RSH-001" ;
  triage:title "r-5 replaces parse_outcome with CheckResponse::into_answers. Its stated rule list (lines 1" ;
  triage:description "r-5 replaces parse_outcome with CheckResponse::into_answers. Its stated rule list (lines 103-108, 144-145, and the test_response_rules_rejected cases at line 263) drops two checks the current code enforces. One is response `model` equals the request model. The other is that a choice/score answer's probability keys equal the question's criteria keys. The planned rules only say the choice is a criteria option and the probabilities sum to 1. A reply can therefore carry arbitrary probability labels, or labels that are a subset or superset of the options, and still pass. Those labels then flow into DecisionAnswers, the session document and the r-6 answers_json log column. The noul rule (line 236, `exactly {\"yes\": p}`) is stated in prose but has no rejection case in the acceptance list (wrong key set, extra `no` key, p outside [0,1]). Recommendation: State in r-5 that into_answers keeps the existing checks: response model equals the request model, and probability keys for choice/score equal the criteria keys. Add the noul key-set and range cases to the existing test_response_rules_rejected list. This carries current behaviour over and adds no new gate. All failures stay RESPONSE_INVALID." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
