<urn:atm:triage:finding/R7-QA2-RQA-QA-001>
  a triage:Finding ;
  triage:findingId "R7-QA2-RQA-QA-001" ;
  triage:title "A git timeout is reported as EXTRACTION_TIMEOUT, whose fix hint says 'Raise timeout_seconds above N or reduce the input so extraction finish" ;
  triage:description "A git timeout is reported as EXTRACTION_TIMEOUT, whose fix hint says 'Raise timeout_seconds above N or reduce the input so extraction finishes in time.' This misleads the user. The git deadline (GIT_DEADLINE, 60 s, git.rs) is a fixed constant and the doc says it is 'not configurable'. No timeout_seconds setting exists for it, so the user cannot act on the first half of the hint. The git call may also be a rev read, a repo-root discovery or hash-object. 'Reduce the input' does not describe a hung or slow git (a stuck lock, a network filesystem, a huge repo). The Display text 'extraction timed out after 60s' also names the wrong stage." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T02:50:45Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R7 ;
  triage:foundAt "2026-11-08T04:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R7-QA2-RQA-QA-001/PA-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R7-QA2-RQA-QA-001/R7-1> ;
  triage:triageRecordVersion "1" .

