<urn:atm:triage:finding/R5-QA1-REQ-QA-002>
  a triage:Finding ;
  triage:findingId "R5-QA1-REQ-QA-002" ;
  triage:title "A noul question cannot be sent through the shipped caller path" ;
  triage:description "A noul question cannot be sent through the shipped caller path. validate_question_set rejects any question with empty choices (question q choices are empty), and noul requires empty choices. --request-json calls it at caller.rs:43. Question-set files (check.toml) refuse every type other than choice at questions.rs:45. Library users of Question::try_new and the facade payload can reach noul, but sc-ai jev --request-json can reach choice and score only. Your note says all Jev question formats must be supported." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "implementation-drift" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T05:57:02Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R5 ;
