<urn:atm:triage:finding/R5-QA1-RBP-F002>
  a triage:Finding ;
  triage:findingId "R5-QA1-RBP-F002" ;
  triage:title "Error provenance is carried by string sniffing" ;
  triage:description "Error provenance is carried by string sniffing. Own-rule errors are tagged with the literal prefix `jev::v1: ` (OWN_MESSAGE) inside a serde error message, and `describe` recovers them with `strip_prefix`. `TryFrom<RawJevQuestion>` and `TryFrom<RawQuestion>` use `type Error = String`, which flattens the structured JevError (via `detail()`) back into text. Any serde message that happens to start with the prefix is treated as safe to show, and the error structure is lost across layers." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP-001" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T05:57:12Z"^^xsd:dateTime ;
