<urn:atm:triage:finding/R7-QA1-FTQ-003>
  a triage:Finding ;
  triage:findingId "R7-QA1-FTQ-003" ;
  triage:title "refused_port() binds 127.0.0.1:0, reads the port, and drops the listener. The test then co" ;
  triage:description "refused_port() binds 127.0.0.1:0, reads the port, and drops the listener. The test then connects to that port and expects a connect-phase failure. In the window between the drop and the connect, any other test in the same process (LoopbackServer::spawn binds 127.0.0.1:0 in parallel tests) or another process can bind the freed port. The client then connects to that other listener, not to a refused port. The test sees a successful or different response, or the other test's server records an unexpected request and fails its finish() count. This is a port-reuse race on a shared socket resource. The likelihood is low because ephemeral allocation usually does not hand back a just-freed port immediately, but the mechanism is concrete and the test has no way to detect it." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "fixed_runtime_path" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
