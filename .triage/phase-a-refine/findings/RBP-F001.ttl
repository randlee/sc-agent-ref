<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "SendTrace is a shared first-write-wins cell (Arc<OnceLock>), and JudgeRequest carries it a" ;
  triage:description "SendTrace is a shared first-write-wins cell (Arc<OnceLock>), and JudgeRequest carries it and is cloned. Any clone of a request shares one trace. If a second backend send reuses a cloned request, its record() is silently dropped, and the second row logs the first backend's request_sha256 with no error. r-6 D3 prevents this only by 'the engine creates a fresh SendTrace per send', which is a convention. Recommendation: Make single-use ownership a property of the type, not engine discipline. Options: (a) implement Clone for JudgeRequest by hand so the clone gets a fresh SendTrace; or (b) make the trace belong to one send, with the engine creating it and backends receiving it per judge call rather than on the cloneable request; or (c) have record() return a bool or debug-assert on a second write so reuse is visible. Add a rustdoc comment on the OnceLock saying why shared interior mutation is needed here (RBP-006 justification)." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-07T22:47:46Z"^^xsd:dateTime ;
