<urn:atm:triage:finding/RBP-F009>
  a triage:Finding ;
  triage:findingId "RBP-F009" ;
  triage:title "ProjectLabel(Arc<str>) is specified with only new() and as_str(). It has no Display, FromS" ;
  triage:description "ProjectLabel(Arc<str>) is specified with only new() and as_str(). It has no Display, FromStr, AsRef<str>, Serialize/Deserialize or Hash. The plan relies on CLI (--project), Python and try_from_fields all using one validator, which in practice needs FromStr (clap) and serde. ModelId in the same sprint gets the full set. The raw-String path is therefore the easy one. Recommendation: Specify Display, FromStr (same validator), AsRef<str>, Hash, and serde via FromStr/as_str, matching ModelId. State that the Debug output is safe, since the text is caller text and not scrubbed." ;
  triage:phaseId "phase-a-refine" ;
