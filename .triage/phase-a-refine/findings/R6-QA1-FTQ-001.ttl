<urn:atm:triage:finding/R6-QA1-FTQ-001>
  a triage:Finding ;
  triage:findingId "R6-QA1-FTQ-001" ;
  triage:title "The fixture repository is created with subprocess.run(['git','init',...], env={**os.environ, 'GIT_CONFIG_GLOBAL': devnull, 'GIT_CONFIG_NOSYS" ;
  triage:description "The fixture repository is created with subprocess.run(['git','init',...], env={**os.environ, 'GIT_CONFIG_GLOBAL': devnull, 'GIT_CONFIG_NOSYSTEM': '1'}). The ambient GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE, GIT_OBJECT_DIRECTORY, GIT_COMMON_DIR and similar variables are inherited. Git hooks such as pre-commit export GIT_INDEX_FILE and sometimes GIT_DIR. When pytest is launched from such a context, 'git init' initialises or reinitialises the host repository instead of tmp_path/repo, and the later toplevel discovery from src/pkg resolves against the host. The test's CONFIG_INVALID and .env expectations then fail. Whether it fails depends on how the suite was launched, not on a random draw. The Rust side already strips these variables (crates/sc-agent-types/src/git.rs lines 98-102, and the git() helpers in crates/sc-jev-check/tests/repo.rs and crates/sc-jev-host/tests/log_context.rs), so this is the one fixture that does not." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "env_leak" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T06:08:56Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R6 ;
  triage:foundAt "2026-11-08T06:07:39Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R6-QA1-FTQ-001/A1R6-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R6-QA1-FTQ-001/A1R6-2> ;
  triage:triageRecordVersion "1" .

