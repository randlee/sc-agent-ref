<urn:atm:triage:finding/R7-QA2-ARCH-001>
  a triage:Finding ;
  triage:findingId "R7-QA2-ARCH-001" ;
  triage:title "The engine's send() suppresses the LogEvent when the request token was already cancelled at entry and the backend returns NETWORK_ERROR kind" ;
  triage:description "The engine's send() suppresses the LogEvent when the request token was already cancelled at entry and the backend returns NETWORK_ERROR kind Cancelled (lines 806-820). The engine still records that backend as Step::Failed with Attestation::Failed (lines 618-625, 681-682), so the result and the log disagree. The only no-log case the engine defines is NotSent (refused before a send). The binding requirement REQ-SAG-0610 (docs/requirements.md:102) says every Jev/LLM prompt send emits a LogEvent, and the ADR-SAG-0013 expectation recorded in the r-2b sprint and the plan-review-5 disposition (ARCH-R2B-002) is 'every judge call emits one LogEvent, a Failed backend included, NotSent emits none'. The new test crates/sc-jev-check/src/run/tests.rs:643-679 (cancelled_before_send_emits_no_log_event) codifies the suppression. The ADR-SAG-0013 body text is general, so the binding basis is REQ-SAG-0610 read with ADR-SAG-0013." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RULE-ADR-CODE" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T04:33:39Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R7 ;
  triage:foundAt "2026-11-08T02:45:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R7-QA2-ARCH-001/SR7-4eb8265-1> ;
  triage:triageRecordVersion "1" .

