<urn:atm:triage:finding/R6-QA1-RSH-004>
  a triage:Finding ;
  triage:findingId "R6-QA1-RSH-004" ;
  triage:title "Every session-log event is emitted at Level::Info, whether the send succeeded or failed" ;
  triage:description "Every session-log event is emitted at Level::Info, whether the send succeeded or failed. A failed send (send_outcome = \"failed\", with error_code set) is indistinguishable by level from a successful one, so level-based filtering or alerting at WARN or ERROR cannot see failed sends." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "structured_logging_tracing" ;
  triage:severity "minor" ;
