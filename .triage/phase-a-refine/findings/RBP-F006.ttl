<urn:atm:triage:finding/RBP-F006>
  a triage:Finding ;
  triage:findingId "RBP-F006" ;
  triage:title "Two binding signatures disagree and one fake failure path loses data. (1) Sha256Digest::of" ;
  triage:description "Two binding signatures disagree and one fake failure path loses data. (1) Sha256Digest::of takes &str (r-7 D2.5, r-6 l.318), but MockJudgeBackend::with_sent_body(body: impl Into<Vec<u8>>) is documented as 'records Sha256Digest::of(body)' (l.340-343, 214-216), which does not type-check. (2) send_with_busy_retry hashes only 'if let Ok(text) = from_utf8(request.body())', and the comment calls the Err arm 'unreachable in practice'. A non-UTF-8 body silently leaves request_sha256 null, contradicting 'SHA-256 of exactly the bytes sent'. Recommendation: Give HttpRequest a text-typed body (String) or a validated body accessor, so UTF-8 is guaranteed by construction and no Result or Option arm is needed. Make with_sent_body take impl Into<String>. If a non-UTF-8 body is truly possible, fail with a typed JevError rather than record nothing." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-07T22:47:41Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-PLAN67 ;
  triage:foundAt "2026-11-07T23:55:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F006/PLAN-214> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F006/PLAN-335> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F006/PLAN-342> ;
  triage:triageRecordVersion "1" .

