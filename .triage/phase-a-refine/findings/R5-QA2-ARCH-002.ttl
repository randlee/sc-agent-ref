<urn:atm:triage:finding/R5-QA2-ARCH-002>
  a triage:Finding ;
  triage:findingId "R5-QA2-ARCH-002" ;
  triage:title "Decode failures built with JevError::encode_failed carry an encode-side retry hint" ;
  triage:description "CheckRequest::parse maps every serde failure to JevError::encode_failed (v1.rs:563-564). The same pattern is in CanonicalJudgePayload::from_bytes (payload.rs:408-409). The code is INPUT_INVALID, as the ADR requires. But the EncodeFailed hint reads 'could not be encoded as JSON ... Retry; if it persists, report it as a bug' (error.rs:833). That is the wrong guidance for a malformed caller body or payload. Sprint item 9 asks for InputInvalid with a fix hint, and this is the opposite of a fix hint. The variant is also an encode-side recovery category in ADR-SAG-0027, and these are decode failures. I am not marking it Blocking because the ADR fixes only the code mapping, and ErrorCode, exit code and retryable() are all correct." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RULE-ADR-CODE" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T06:20:15Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R5 ;
  triage:foundAt "2026-11-08T06:19:25Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R5-QA2-ARCH-002/SPRINT-1> ;
  triage:triageRecordVersion "1" .

