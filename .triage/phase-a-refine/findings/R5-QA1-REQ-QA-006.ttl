<urn:atm:triage:finding/R5-QA1-REQ-QA-006>
  a triage:Finding ;
  triage:findingId "R5-QA1-REQ-QA-006" ;
  triage:title "(a) The all-types fixture and test payload carry the prior answer {question_id: quality, choice: yes}, but quality's choices are pass and fa" ;
  triage:description "(a) The all-types fixture and test payload carry the prior answer {question_id: quality, choice: yes}, but quality's choices are pass and fail. sc-jev-check's `validate_state` would refuse that state as 'not in the question'. (b) The `CanonicalJudgePayload::from_bytes` doc says the error never names a payload byte outside a question id, but it formats the raw serde error (`canonical payload is invalid: {error}`). For type mismatches serde_json echoes the offending value (for example `invalid type: string \"...\"`)." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "implementation-drift" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
