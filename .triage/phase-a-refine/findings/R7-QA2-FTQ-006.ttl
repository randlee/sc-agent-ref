<urn:atm:triage:finding/R7-QA2-FTQ-006>
  a triage:Finding ;
  triage:findingId "R7-QA2-FTQ-006" ;
  triage:title "The test asserts `started.elapsed() < Duration::from_secs(10)` in addition to the typed EXTRACTION_TIMEOUT" ;
  triage:description "The test asserts `started.elapsed() < Duration::from_secs(10)` in addition to the typed EXTRACTION_TIMEOUT. The wall-clock check is redundant: run_with_deadline can only return Err here through the deadline (spawn of `sleep` cannot fail, and try_wait on a live child does not error), so the error assertion already proves the deadline fired. If the deadline did not fire, `sleep 30` would return Ok after 30 s and expect_err would fail. The 10 s check adds only flake exposure: a host stall of more than 10 s, or a suspended CI VM, fails the test even though the behaviour is correct. It also contradicts the FTQ-002 convention stated in the runner (deadline.rs:201-202, 'No wall-clock asserts (FTQ-002)')." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "timing_assertion" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
