<urn:atm:triage:finding/R2B-RBP-F003>
  a triage:Finding ;
  triage:findingId "R2B-RBP-F003" ;
  triage:title "default_backends() returns Result<BackendSet, JevError> for BackendSet::try_from" ;
  triage:description "default_backends() returns Result<BackendSet, JevError> for BackendSet::try_from(vec![BackendId::Jev]), a one-element list that cannot fail. The doc comment concedes this ('cannot fail'). The dead error path is propagated with ? from prepare (line 429) instead of being expressed in the type. Recommendation: Add an infallible constructor on BackendSet (for example BackendSet::single(id) or Default) and return BackendSet directly. Otherwise make the invariant explicit with a single documented expect so the 'never fails' claim is auditable." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
