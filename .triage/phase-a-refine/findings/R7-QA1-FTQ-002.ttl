<urn:atm:triage:finding/R7-QA1-FTQ-002>
  a triage:Finding ;
  triage:findingId "R7-QA1-FTQ-002" ;
  triage:title "The test relies on a wall-clock margin for ordering. It assumes the 1 s client request dea" ;
  triage:description "The test relies on a wall-clock margin for ordering. It assumes the 1 s client request deadline (Timeouts::new(2 s connect, 1 s request)) will not expire before the client has finished connecting and writing the request. The comment says '1 s leaves ample time to connect and write the request first', and the test then asserts `server.finish().len() == 1`. On a starved CI host the client's request deadline can expire before the server thread has read the request. The server then records 0 requests, and the `seen.len()` assertion inside finish() fails. No handshake orders the server's receipt before the client's timeout, so the outcome depends on scheduling. The clock is real because ureq uses the system clock, so it cannot be injected here." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "timing_assertion" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T02:33:38Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R7 ;
  triage:foundAt "2026-11-08T02:30:00Z"^^xsd:dateTime ;
