<urn:atm:triage:finding/R5-QA1-RBP-F003>
  a triage:Finding ;
  triage:findingId "R5-QA1-RBP-F003" ;
  triage:title "CheckRequest::parse documents 'INPUT_INVALID when body is not a check request', but every non-own serde failure, including Data shape errors" ;
  triage:description "CheckRequest::parse documents 'INPUT_INVALID when body is not a check request', but every non-own serde failure, including Data shape errors, returns ENCODE_FAILED. CanonicalJudgePayload::from_bytes does the same for Data versus other categories, so the two parsers split codes differently. In `parse`, the text computed by `describe` is discarded in the non-own branch and the error is rebuilt with `encode_failed`." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP-001" ;
  triage:severity "minor" ;
  triage:repeatable false ;
