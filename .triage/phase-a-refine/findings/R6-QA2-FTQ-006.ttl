<urn:atm:triage:finding/R6-QA2-FTQ-006>
  a triage:Finding ;
  triage:findingId "R6-QA2-FTQ-006" ;
  triage:title "The make_fifo helper spawns mkfifo with Command::new(...).status(), which waits with no deadline" ;
  triage:description "The make_fifo helper spawns mkfifo with Command::new(...).status(), which waits with no deadline. This bypasses the workspace's bounded runner (deadline.rs, which every other subprocess in this file uses), so a stalled child would hang the test instead of failing at 60 s. The disallowed_methods expect() only justifies the direct spawn; it does not bound the wait." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "qa" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
