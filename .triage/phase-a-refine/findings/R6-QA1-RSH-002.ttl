<urn:atm:triage:finding/R6-QA1-RSH-002>
  a triage:Finding ;
  triage:findingId "R6-QA1-RSH-002" ;
  triage:title "The session-log flush is skipped on the error path" ;
  triage:description "The session-log flush is skipped on the error path. HostRun::run calls run(self.prepared)? (line 344), so when every backend fails and run returns Err, the flush warning is never produced. The adapter is then dropped, and LoggerInner::drop discards flush and shutdown errors (crates/sc-jev-host/src/obs.rs:45-52). A flush failure on the path where failed send rows matter most is therefore silent. ask_from has the same shape: ask(...)? at compose.rs:419 returns before finish_log at line 420." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "graceful_shutdown_flush" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T06:08:57Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R6 ;
  triage:foundAt "2026-11-08T06:07:39Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R6-QA1-RSH-002/INT-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R6-QA1-RSH-002/INT-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R6-QA1-RSH-002/SPR-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R6-QA1-RSH-002/SPR-2> ;
