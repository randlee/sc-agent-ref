<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "The question-kind invariants (choice 2..=255, score 2..=10, noul has no choices or descrip" ;
  triage:description "The question-kind invariants (choice 2..=255, score 2..=10, noul has no choices or descriptions, descriptions has one entry per choice) are not held by the type. with_kind/with_descriptions are infallible, Deserialize is derived, and the rules run later in a separate 'then the question-kind rules' step. That step is repeated by both sc-jev and sc-jev-backends. Invalid Questions are therefore constructible and the invariant is re-checked per call site. Recommendation: Validate once in sc-decision-schema: a fallible Question or CanonicalJudgePayload constructor, or #[serde(try_from)] on deserialize, or a single CanonicalJudgePayload::validate() that both crates call. Do not keep two copies of the rules. Also model kind as a three-variant QuestionKind { Choice, Score, Noul } with skip_serializing_if = is_choice, so None is not an implicit 'choice' sentinel. This keeps the bytes of existing payloads identical." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-07T22:47:35Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-PLAN67 ;
  triage:foundAt "2026-11-07T23:55:00Z"^^xsd:dateTime ;
