<urn:atm:triage:finding/RBP-F013>
  a triage:Finding ;
  triage:findingId "RBP-F013" ;
  triage:title "RunConfig::log_context is optional ('unset: repo = RunConfig's repo_root, project = None')" ;
  triage:description "RunConfig::log_context is optional ('unset: repo = RunConfig's repo_root, project = None'). The default silently yields the worktree root where the log field means the main repository (ADR-SAG-0031), so a caller that skips the setter writes a wrong repo into every row. Correct use depends on compose always remembering to set it. Recommendation: Make the context required at the point the engine emits rows (a constructor argument or a type-level 'configured' state), or have the default call discover_main_repo_root so unset still gives the documented meaning." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
