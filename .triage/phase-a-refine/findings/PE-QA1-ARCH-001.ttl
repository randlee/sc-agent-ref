<urn:atm:triage:finding/PE-QA1-ARCH-001>
  a triage:Finding ;
  triage:findingId "PE-QA1-ARCH-001" ;
  triage:title "The 'Phase A crate graph' prose (lines 23-40) was not updated when r-3b landed. It still says 'Only the composition roots sc-ai and sc-jev-p" ;
  triage:description "The 'Phase A crate graph' prose (lines 23-40) was not updated when r-3b landed. It still says 'Only the composition roots sc-ai and sc-jev-py depend on full sc-observability' and draws sc-ai and sc-jev-py linking sc-observability directly. The binding ADR-SAG-0013 r-3b amendment, the ADR-SAG-0010 r-3b amendment, the A.1 graph at lines 66-97 and crates/sc-jev-host/Cargo.toml:27 all say sc-jev-host is the only crate that links sc-observability. The Cargo manifests of sc-ai and sc-jev-py show no sc-observability dependency. The repo-level architecture doc therefore contradicts its own Active ADRs. The graph at lines 23-35 also omits sc-jev-host, sc-agent-http and sc-decision-schema. The 'starting point' note at line 83 does not cover the false sentence at 38-40." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
