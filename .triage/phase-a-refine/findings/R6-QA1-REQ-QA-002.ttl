<urn:atm:triage:finding/R6-QA1-REQ-QA-002>
  a triage:Finding ;
  triage:findingId "R6-QA1-REQ-QA-002" ;
  triage:title "D1 says a non-ULID id is INPUT_INVALID with the hint '... with `run_check`' (Python)" ;
  triage:description "D1 says a non-ULID id is INPUT_INVALID with the hint '... with `run_check`' (Python). REQ-SAG-0612 says a UUID id is INPUT_INVALID 'in CLI and Python'. The acceptance row names pytest `test_uuid_session_id_is_input_invalid`. The developer recorded that Python takes no session id (only `Session.ask` with the id the run returned), so the Python refusal path and its hint do not exist. The test of that name therefore asserts that ids are 26-character ULIDs and never feeds a UUID. The grep found no Python entry point that accepts a session id, so the choice looks sound. The defect is that the sprint doc still promises the Python hint and refusal, and the test name claims a refusal it does not run." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "acceptance-gap" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
