<urn:atm:triage:finding/R2B-RBP-F001>
  a triage:Finding ;
  triage:findingId "R2B-RBP-F001" ;
  triage:title "Semantic question ids and choice labels are carried as raw String/Vec<String> (ParsedQuestion)" ;
  triage:description "Semantic question ids and choice labels are carried as raw String/Vec<String> (ParsedQuestion { id: String, choices: Vec<String> }). validate_questions re-parses the canonical bytes and re-runs the id-present, duplicate-id and choices-are-strings checks. wire::parse_answers (wire.rs:292-353) compares reply keys and labels as &str sets. backend::typed_answers (backend.rs:89-106) then validates each id a third time with QuestionId::try_from, after the paid judge call. PayloadBundle already holds the validated typed form (payload.rs:134, 235). Recommendation: drop ParsedQuestion and the byte re-parse for ids and choices; use request.payload().question_choices() (QuestionId/ChoiceId) in parse_answers and typed_answers, and keep only the type and prompt checks the bundle does not cover. Id validity is then decided once, at PayloadBundle::encode." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-07T22:49:57Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R2B ;
