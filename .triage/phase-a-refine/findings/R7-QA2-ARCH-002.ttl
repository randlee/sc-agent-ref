<urn:atm:triage:finding/R7-QA2-ARCH-002>
  a triage:Finding ;
  triage:findingId "R7-QA2-ARCH-002" ;
  triage:title "workspace-tests gains a dev-dependency on sc-decision-schema (also boundaries/workspace-tests/workspace-tests.toml:31 allowed_dependencies)" ;
  triage:description "workspace-tests gains a dev-dependency on sc-decision-schema (also boundaries/workspace-tests/workspace-tests.toml:31 allowed_dependencies). ADR-SAG-0028 (docs/architecture.md:1537-1546) states the dev-dependencies are 'exactly' sc-agent-types, sc-jev-check, sc-jev-host, serde_json, tempfile. The ADR-SAG-0028 section (docs/architecture.md:1522-1564) has no r-7 amendment, and the sprint's owned_paths amendment list (sprint doc line 172) names only ADR-SAG-0005, 0009, 0016, 0017, 0019, 0022, 0026 and 0027. The sprint doc still names ADR-SAG-0028 in its adrs list (line 84) as 'workspace-tests gains a dev edge on sc-decision-schema'. A sprint deliverable cannot relax a binding ADR, so this contradiction is Blocking under RULE-ADR-PLAN as well as RULE-ADR-CODE." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RULE-ADR-CODE" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T02:50:27Z"^^xsd:dateTime ;
