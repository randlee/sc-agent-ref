<urn:atm:triage:finding/PE-QA1-REQ-QA-003>
  a triage:Finding ;
  triage:findingId "PE-QA1-REQ-QA-003" ;
  triage:title "Crate tables do not carry every root id for the crate that owns the subject. REQ-SAG-0105, 0106 and 0108 are r-1 rows about sc-agent-types (" ;
  triage:description "Crate tables do not carry every root id for the crate that owns the subject. REQ-SAG-0105, 0106 and 0108 are r-1 rows about sc-agent-types (backend descriptor, JevError variants, SubjectsDocument) and are absent from docs/sc-agent-types/requirements.md. The plan required only 0101, 0103, 0120, 0121 and NFR-0001 there, so this is a gap against the review brief, not against plan text. REQ-SAG-0606 (r-2b, equal from backend-reported digests) is absent from docs/sc-jev-check/requirements.md and from every other crate requirements doc. The same grep found 0606 only in the root table, architecture docs, sprint docs, code and boundary manifests. Add crate-level rows with an owning sprint and test reference: 0105, 0106 and 0108 in docs/sc-agent-types/requirements.md, and 0606 in docs/sc-jev-check/requirements.md. Alternatively record in each crate doc that the root table is authoritative for these ids. partially-compliant" ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "cross-doc-conflict" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
