<urn:atm:triage:finding/R7-QA1-RSH-001>
  a triage:Finding ;
  triage:findingId "R7-QA1-RSH-001" ;
  triage:title "Busy retry resends non-idempotent POST bodies on status 502 as well as 429 and 529. For LL" ;
  triage:description "Busy retry resends non-idempotent POST bodies on status 502 as well as 429 and 529. For LLM provider calls (judge message and count requests) a 502 can come from a gateway after the provider already processed and billed the request, so a resend can double-charge or double-process." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "retries" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T02:33:43Z"^^xsd:dateTime ;
