<urn:atm:triage:finding/R7-QA1-RSH-002>
  a triage:Finding ;
  triage:findingId "R7-QA1-RSH-002" ;
  triage:title "Git subprocesses used for revision reads (rev-parse, cat-file -t, cat-file -s, cat-file blob) have no wall-clock deadline" ;
  triage:description "Git subprocesses used for revision reads (rev-parse, cat-file -t, cat-file -s, cat-file blob) have no wall-clock deadline. A command that blocks, for example on a partial clone that lazily fetches a missing blob from a promisor remote, a stalled network filesystem, or a hung lock, can pin the calling thread indefinitely. The sc-jev-check command extractor enforces a deadline for its own subprocess, so this is inconsistent." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "timeouts" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T02:34:02Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R7 ;
  triage:foundAt "2026-11-08T02:30:00Z"^^xsd:dateTime ;
