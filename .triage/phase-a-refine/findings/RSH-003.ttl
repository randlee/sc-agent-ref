<urn:atm:triage:finding/RSH-003>
  a triage:Finding ;
  triage:findingId "RSH-003" ;
  triage:title "Duplicate-key behaviour is unspecified. OrderedMap is a custom order-preserving visitor, a" ;
  triage:description "Duplicate-key behaviour is unspecified. OrderedMap is a custom order-preserving visitor, and the input_sha256 recovery (item 5) parses the sent body with it. A duplicate question id or criteria key in a recovered body could silently collapse or shadow an entry, giving a digest that differs from prompt_sha256 with no error. Response `answers` is a BTreeMap, where serde keeps the last duplicate id silently. Recommendation: Specify that the OrderedMap visitor and the answers map reject a duplicate key (INPUT_INVALID on request recovery, RESPONSE_INVALID on a reply). Cover it with a case in the existing test_response_rules_rejected and recovery tests rather than a new check." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-07T22:47:51Z"^^xsd:dateTime ;
