<urn:atm:triage:finding/R6-QA1-FTQ-003>
  a triage:Finding ;
  triage:findingId "R6-QA1-FTQ-003" ;
  triage:title "Two independent 20 s wall-clock budgets govern the handshake" ;
  triage:description "Two independent 20 s wall-clock budgets govern the handshake. The worker thread's deadline starts before build_request spawns the extractor. The child's own 20 s poll starts only after it has written 'started'. On a loaded host where the interpreter start is slow, the worker gives up first, never writes 'ack', and the child exits 3. The test then reports EXTRACTION_FAILED with the message 'the GIL was held', although the GIL was never the cause. The failure is intermittent on loaded CI hosts and carries the wrong diagnosis." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "timing_assertion" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T06:08:50Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R6 ;
  triage:foundAt "2026-11-08T06:07:39Z"^^xsd:dateTime ;
