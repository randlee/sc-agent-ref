<urn:atm:triage:finding/RBP-F014>
  a triage:Finding ;
  triage:findingId "RBP-F014" ;
  triage:title "Sha256Digest::of(&str) will normalize CRLF and bare CR to LF under sc-sha, but the name an" ;
  triage:description "Sha256Digest::of(&str) will normalize CRLF and bare CR to LF under sc-sha, but the name and the 'request_sha256 = digest of exactly the bytes sent' contract read as a raw digest. A caller hashing CR-bearing text gets a digest that is not SHA-256 of its bytes. The safety rests on 'compact JSON has no raw CR', which the type does not express. Recommendation: Rename to of_text or document the normalization on the method itself (not only in the sprint doc), so a later caller with CR-bearing input is not surprised." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-07T22:47:51Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-PLAN67 ;
  triage:foundAt "2026-11-07T23:55:00Z"^^xsd:dateTime ;
