<urn:atm:triage:finding/R7-QA2-FTQ-004>
  a triage:Finding ;
  triage:findingId "R7-QA2-FTQ-004" ;
  triage:title "The FTQ-001 fix (04584aa) closes the unbounded wait, but it does so by widening the cargo tree deadline from the 60 s runner default to 5 mi" ;
  triage:description "The FTQ-001 fix (04584aa) closes the unbounded wait, but it does so by widening the cargo tree deadline from the 60 s runner default to 5 minutes (CARGO_TREE_DEADLINE). The stated cause is a held Cargo file lock, which is contention with other cargo processes. The nondeterminism is not removed. tree() in this file is not serialized with bin_path()'s BUILD_LOCK (bin_path.rs:70), so cargo tree and cargo build run concurrently as threads of one test binary. Under cargo nextest or parallel CI jobs in the same workspace, separate processes contend for the same package-cache and build locks. The test passes only when the competing cargo process releases the lock within 5 minutes, and tree() is called twice per test (lines 81 and 97). The same widening pattern appears in features.rs:24 (CARGO_TREE_DEADLINE, four calls per test) and bin_path.rs:27 (BIN_BUILD_DEADLINE 20 min). A wider bound converts a fast failure into a slow one and hides the lock race rather than removing it. Under the fix standard this is timeout widening around a race." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "masking_fix" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T02:50:51Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R7 ;
  triage:foundAt "2026-11-08T04:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R7-QA2-FTQ-004/R7-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R7-QA2-FTQ-004/R7-2> ;
  triage:triageRecordVersion "1" .

