<urn:atm:triage:finding/R7-QA2-FTQ-005>
  a triage:Finding ;
  triage:findingId "R7-QA2-FTQ-005" ;
  triage:title "After the deadline fires, the runner calls kill_tree and then child.wait() with no bound" ;
  triage:description "After the deadline fires, the runner calls kill_tree and then child.wait() with no bound. kill_tree also runs an external kill process via Command::status() with no bound. The module doc (line 9) states 'Every wait is bounded', which is false for these two waits. A child that SIGKILL cannot end promptly (for example, a process in uninterruptible I/O sleep on a hung filesystem or network mount) would leave the test blocked forever instead of failing with the captured stderr. Likelihood is low, but the path exists and contradicts the stated contract." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "unbounded_wait" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T02:50:35Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R7 ;
  triage:foundAt "2026-11-08T04:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R7-QA2-FTQ-005/IPA-1> ;
