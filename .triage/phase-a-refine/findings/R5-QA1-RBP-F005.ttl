<urn:atm:triage:finding/R5-QA1-RBP-F005>
  a triage:Finding ;
  triage:findingId "R5-QA1-RBP-F005" ;
  triage:title "The constant labels `yes` and `no` are built repeatedly through fallible `ChoiceId::try_from`" ;
  triage:description "The constant labels `yes` and `no` are built repeatedly through fallible `ChoiceId::try_from`. In `answer_labels` the failure is swallowed with `filter_map(...ok())`, so a future tightening of ChoiceId validation would give noul questions an empty label set with no error. In `map_answer` (v1.rs:757-760) the same constants propagate a Result that cannot fail." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP-007" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T05:57:00Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R5 ;
