<urn:atm:triage:finding/R6-QA1-FTQ-004>
  a triage:Finding ;
  triage:findingId "R6-QA1-FTQ-004" ;
  triage:title "run_from and ask_from flush the file logger through a barrier with a 5 s default timeout (sc-observability 1.5.0, DEFAULT_WRITER_SHUTDOWN_TI" ;
  triage:description "run_from and ask_from flush the file logger through a barrier with a 5 s default timeout (sc-observability 1.5.0, DEFAULT_WRITER_SHUTDOWN_TIMEOUT and flush_with_timeout in runtime.rs). If the writer stalls past 5 s, flush returns Err. compose.rs turns that into a response warning ('session log was not flushed'). The test discards response.warnings() from both calls and then reads the JSONL file, so a flush timeout appears only as an opaque row-count assertion (rows.len() == 1 or == 2). That is intermittent under load and does not name its cause." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "timing_assertion" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
