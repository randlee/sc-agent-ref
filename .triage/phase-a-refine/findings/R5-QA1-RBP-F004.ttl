<urn:atm:triage:finding/R5-QA1-RBP-F004>
  a triage:Finding ;
  triage:findingId "R5-QA1-RBP-F004" ;
  triage:title "`Question::new` and `CanonicalJudgePayload::new` are public, infallible constructors that bypass the kind rules (2 to 255 choices, distinct " ;
  triage:description "`Question::new` and `CanonicalJudgePayload::new` are public, infallible constructors that bypass the kind rules (2 to 255 choices, distinct choices, and so on). The type doc says the kind rules hold for every question, but a Question that breaks them can be built safely and passed to `PayloadBundle::encode`. The rules are re-checked later by deserializing the bytes in `prepare` and `validate_questions`. Tests construct invalid values on purpose (check.rs:243, validate.rs:118)." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP-004" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T05:56:54Z"^^xsd:dateTime ;
