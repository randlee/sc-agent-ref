<urn:atm:triage:finding/RBP-F004>
  a triage:Finding ;
  triage:findingId "RBP-F004" ;
  triage:title "RowContext holds SystemTime for session_created_at and ts, but the projection truncates to" ;
  triage:description "RowContext holds SystemTime for session_created_at and ts, but the projection truncates to ms. A row built from a real clock does not equal try_from_fields(to_fields(row)), because SessionLogRow derives PartialEq. The plan's 'test_fields_roundtrip (every fixture line)' passes only because fixtures are ms-aligned. answer_id is a raw String ('r-7 checks non-empty only') beside the typed session_id, and repo is raw String. The ok()/failed() constructors are infallible, so the only check, on answer_id, can run only on the parse path. to_fields can emit an empty answer_id. Recommendation: Introduce a ms-precision timestamp newtype whose constructor truncates, so the type holds what the column stores. Introduce an AnswerId newtype next to SessionId (a validated 26-char Crockford ULID in r-7; r-6 swaps in Ulid). Keep repo text, but document the lossy-path rule on RowContext. Alternatively make ok()/failed() fallible." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-07T22:47:39Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-PLAN67 ;
  triage:foundAt "2026-11-07T23:55:00Z"^^xsd:dateTime ;
