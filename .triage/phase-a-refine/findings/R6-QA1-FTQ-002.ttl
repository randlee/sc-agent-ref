<urn:atm:triage:finding/R6-QA1-FTQ-002>
  a triage:Finding ;
  triage:findingId "R6-QA1-FTQ-002" ;
  triage:title "subprocess.run for 'git init' has no timeout" ;
  triage:description "subprocess.run for 'git init' has no timeout. A stalled git process, for example one blocked on a lock or a stalled filesystem, blocks the whole pytest session with no failure. Every other subprocess in the workspace is bounded by the 60 s deadline runner (tests/support/deadline.rs), so this is the one unbounded spawn in the targeted set." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "unbounded_wait" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
