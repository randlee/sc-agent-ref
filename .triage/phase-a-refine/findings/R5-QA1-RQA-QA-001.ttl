<urn:atm:triage:finding/R5-QA1-RQA-QA-001>
  a triage:Finding ;
  triage:findingId "R5-QA1-RQA-QA-001" ;
  triage:title "`cargo test --all-features` fails to link the sc-jev-py lib-test binary on macOS (undefined _Py* symbols)" ;
  triage:description "`cargo test --all-features` fails to link the sc-jev-py lib-test binary on macOS (undefined _Py* symbols). The `extension-module` feature enables `pyo3/extension-module`, which deliberately omits libpython linkage, so a test executable cannot link. This is pre-existing and not caused by r-5." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "tests" ;
  triage:severity "minor" ;
  triage:repeatable false ;
