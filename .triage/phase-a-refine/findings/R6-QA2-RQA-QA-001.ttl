<urn:atm:triage:finding/R6-QA2-RQA-QA-001>
  a triage:Finding ;
  triage:findingId "R6-QA2-RQA-QA-001" ;
  triage:title "RSH-003 and RSH-004 have no test coverage" ;
  triage:description "RSH-003 and RSH-004 have no test coverage. Nothing asserts that the logged envelope carries correlation_id = session id and request_id = answer id, or that a failed send logs at Warn and a successful one at Info. The assignment asked to update affected golden tests, but none assert these fields. The parse path also uses .ok(), so an id that failed to deserialize would silently log None." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "qa" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T06:41:19Z"^^xsd:dateTime ;
