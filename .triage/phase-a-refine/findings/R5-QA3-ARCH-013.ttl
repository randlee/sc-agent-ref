<urn:atm:triage:finding/R5-QA3-ARCH-013>
  a triage:Finding ;
  triage:findingId "R5-QA3-ARCH-013" ;
  triage:title "ARCH-002 closure is complete for the two named entry points (CanonicalJudgePayload::from_bytes at payload.rs:428 and CheckRequest::parse at " ;
  triage:description "ARCH-002 closure is complete for the two named entry points (CanonicalJudgePayload::from_bytes at payload.rs:428 and CheckRequest::parse at jev/v1.rs:565 now use decode_failed, which returns INPUT_INVALID with category and line/column only and a fix hint). Two decode-side sites still use encode_failed: Question::from_json (payload.rs:245) and PayloadBundle::decode (payload.rs:520). Their code is still INPUT_INVALID, which ADR-SAG-0027 and ADR-SAG-0029(c) accept. However, encode_failed's fix hint (crates/sc-agent-types/src/error.rs:833-835) reads '… could not be encoded as JSON' for a parse failure, which is misleading. The stated rule 'encode_failed kept for encode-side sites only' is not what the tree does. Note: the Question::from_json doc block (payload.rs:229-231) says 'EncodeFailed', and the Errors section says INPUT_INVALID." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "qa" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-11-08T06:41:21Z"^^xsd:dateTime ;
  triage:foundIn triage:A1-R5 ;
  triage:foundAt "2026-11-08T06:39:59Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R5-QA3-ARCH-013/integrate-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R5-QA3-ARCH-013/sprint-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/R5-QA3-ARCH-013/sprint-2> ;
  triage:triageRecordVersion "1" .

