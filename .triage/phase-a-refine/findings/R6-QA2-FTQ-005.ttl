<urn:atm:triage:finding/R6-QA2-FTQ-005>
  a triage:Finding ;
  triage:findingId "R6-QA2-FTQ-005" ;
  triage:title "The concurrent-writer helper joins eight std threads with no deadline" ;
  triage:description "The concurrent-writer helper joins eight std threads with no deadline. If any writer thread wedges inside save() or load(), the test blocks forever instead of failing, and the CI job only ends at its own timeout. Today the store takes no lock (session/mod.rs:21 states there is no lock), so no blocking path is reachable and this is not a current flake. It still violates the Fix Standard: a join with no hard deadline is a path on which the test can block forever." ;
  triage:phaseId "phase-a-refine" ;
  triage:triageMode "initial_pass" ;
  triage:category "qa" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
